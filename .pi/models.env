# Project-local Pi launcher switchboard.
# The primary coding model stays on DeepSeek V4 Flash.
export PI_MAIN_MODEL="opencode-go/deepseek-v4-flash"
export PI_MAIN_THINKING="max"
export PI_ENABLED_MODELS=""

# pi-vision-tool delegate for image analysis. This keeps DeepSeek as the
# text/coding model while describe_image sends screenshots to an image-capable
# model on the same opencode-go provider.
#
# qwen3.6-plus is used here because Pi currently exposes it through the
# openai-completions API with text+image input, which matches pi-vision-tool's
# direct /chat/completions delegation path.
export PI_VISION_PROVIDER="opencode-go"
export PI_VISION_MODEL="qwen3.6-plus"
export PI_VISION_REASONING_EFFORT="low"

# Startup/network posture. Override in your shell when needed.
export PI_TELEMETRY="0"
export PI_SKIP_VERSION_CHECK="1"
export PI_CACHE_RETENTION="long"
